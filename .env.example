# Docker compose environment — copy to .env and fill in.
# .env is not committed; only this example file is.

# PostgreSQL container
POSTGRES_DB=patent_ppt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_IMAGE=pgvector/pgvector:0.8.5-pg18-trixie
POSTGRES_BIND_ADDRESS=127.0.0.1
# Host port mapped to the container's 5432 (5432 is taken by native PostgreSQL 18)
POSTGRES_HOST_PORT=5433

# Backend/Alembic connection (local host -> PostgreSQL container).
# In the backend container, use PGHOST=postgres and PGPORT=5432 instead.
PGHOST=localhost
PGPORT=5433
PGDATABASE=patent_ppt
PGUSER=postgres
PGPASSWORD=change_me

# Backend / worker image and host bindings. Set APP_IMAGE to a registry path on servers.
APP_IMAGE=patent-backend-worker:local
UV_IMAGE=ghcr.io/astral-sh/uv:0.11.27
PYTHON_IMAGE=python:3.12.13-slim-bookworm
APP_UID=10001
APP_GID=10001
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000
DATA_HOST_PATH=./data
OUTPUT_HOST_PATH=./output
# Host-side Python uses MODEL_ARTIFACT_ROOT; containers use the mounted path below.
MODEL_ARTIFACT_ROOT=./data/model_artifacts
CONTAINER_MODEL_ARTIFACT_ROOT=/app/data/model_artifacts
PATENT_SBERTA_MODEL_DIR=/app/data/model_artifacts/PatentSBERTa
PATENT_SBERTA_MODEL_URL=https://github.com/s1084335/patent-ppt-auto/releases/download/patentsberta-v1/PatentSBERTa.tar.gz
PATENT_SBERTA_MODEL_SHA256=20BA0214BF224FF9C579CC1AF268035400AF00456B1C0C13B8B9261260DA5940

# Worker runtime. GPU allocation is enabled only with docker-compose.gpu.yml.
WORKER_ID=patent-worker-1
WORKER_POLL_SECONDS=3
WORKER_STALE_AFTER_SECONDS=1800
WORKER_HEARTBEAT_TIMEOUT_SECONDS=120
WORKER_LOG_LEVEL=INFO
WORKER_GPUS=all

# PatentSBERTa is not packaged in the production image. Download or mount it
# under PATENT_SBERTA_MODEL_DIR before running embedding jobs.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# Clustering LLM for candidate explanations, topic labels, and summaries.
# Keep real secrets only in .env or the deployment platform's secret store.
CLUSTERING_LLM_PROVIDER=huggingface
CLUSTERING_LLM_BASE_URL=https://router.huggingface.co/v1
CLUSTERING_LLM_MODEL=Qwen/Qwen3-8B:nscale
HF_TOKEN=

# Reserved for the production Claude provider.
ANTHROPIC_API_KEY=

# WIPS import upload cap (bytes); default 200 MiB. Streamed uploads over this return 413.
# Optional IMPORTS_ROOT overrides where uploads land (default ./data/imports).
MAX_IMPORT_UPLOAD_BYTES=209715200
